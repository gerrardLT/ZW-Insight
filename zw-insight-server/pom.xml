    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- JaCoCo agent 占位：prepare-agent 运行时会将 -javaagent 追加到该属性，
             surefire 通过 @{argLine} late 绑定消费；jacoco.skip 时保持空值不破坏 JVM 参数 -->
        <argLine></argLine>

        <!-- 核心依赖版本 -->
        <mybatis-plus.version>3.5.5</mybatis-plus.version>
        <mysql-connector.version>8.0.33</mysql-connector.version>
        <druid.version>1.2.21</druid.version>
        <flowable.version>7.0.1</flowable.version>
        <minio.version>8.5.9</minio.version>
        <knife4j.version>4.4.0</knife4j.version>
        <jwt.version>0.12.5</jwt.version>
        <hutool.version>5.8.26</hutool.version>
        <easyexcel.version>3.3.4</easyexcel.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <lombok.version>1.18.32</lombok.version>
        <jqwik.version>1.9.1</jqwik.version>
        <ip2region.version>2.7.0</ip2region.version>
        <aliyun-dysmsapi.version>3.0.0</aliyun-dysmsapi.version>
        <!-- easyexcel-core 3.3.4 运行时需要 commons-io 2.12+（AbstractStreamBuilder），
             而 spring-boot 3.2 BOM 管理为 2.11.0，不显式钉住会导致 Excel 导出 NoClassDefFoundError -->
        <commons-io.version>2.16.1</commons-io.version>
    </properties>

