    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <parallel>classes</parallel>
                    <threadCount>4</threadCount>
                    <forkCount>1C</forkCount>
                    <reuseForks>true</reuseForks>
                    <!-- 消费 JaCoCo prepare-agent 注入�?-javaagent（late 绑定 @{argLine}），
                         否则覆盖率数据文�?jacoco.exec 不会生成，report �?Skipping 导致覆盖率始终为�?-->
                    <!-- EnableDynamicAgentLoading：JDK21 �?Mockito 动态自挂载 agent 需要此开关，
                         否则�?JaCoCo agent 共存时报 “unable to load MockMaker�?-->
                    <argLine>@{argLine} -XX:+EnableDynamicAgentLoading</argLine>
                    <!-- L1 边界�?IntegrationTest �?integration.mapper 包下�?*MapperTest（Testcontainers 集成测试�?
                         属于 L2（需真实 MySQL/Redis），仅由 Failsafe �?-Pintegration-test profile 下执�?
                         （见 tests/README.md 分层设计）。Surefire 显式排除，保�?mvn test（L1）可离线跑绿�?
                         2026-08-06：integration.mapper �?3 �?MapperTest 此前未被排除，L2 步骤中被 surefire 重复执行�?-->
                    <excludes>
                        <exclude>**/*IntegrationTest.java</exclude>
                        <exclude>**/com/zwinsight/integration/mapper/*MapperTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!-- JaCoCo 代码覆盖率插�?-->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <!-- 准备运行时代理，用于收集覆盖率数�?-->
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <!-- 生成覆盖率报�?-->
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- 覆盖率检查门�?-->
                    <execution>
                        <id>check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>integration-test</id>
            <properties>
                <spring.profiles.active>integration-test</spring.profiles.active>
            </properties>
            <!-- L2 集成测试直连真实 MySQL，各业务模块测试运行时需要驱动（仅此 profile 生效�?-->
            <dependencies>
                <dependency>
                    <groupId>com.mysql</groupId>
                    <artifactId>mysql-connector-j</artifactId>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <!-- 仅匹�?zw-app �?com/zwinsight/integration 包（Testcontainers 基建）；
                                 各业务模块的 com/zwinsight/{module}/integration 直连服务器DB测试不在 L2 范围�?026-08-06 修复�?
                                 �?**/*IntegrationTest.java 过宽，靠 -Dit.test=com.zwinsight.integration.* 收窄但该通配符在 failsafe 3.1.2 零匹配，导致 L2 长期空转�?-->
                            <includes>
                                <include>**/com/zwinsight/integration/*IntegrationTest.java</include>
                                <include>**/com/zwinsight/integration/mapper/*MapperTest.java</include>
                            </includes>
                            <!-- 挂起兜底�?026-08-06）：测试全部结束后若 fork JVM 因残留非守护线程
                                 （Druid 重试/调度器等�?0 秒内未退出则强制结束，避�?CI 无限挂死 -->
                            <forkedProcessExitTimeoutInSeconds>60</forkedProcessExitTimeoutInSeconds>
                            <!-- 测试执行阶段总超�?45 分钟：单个用�?类死等时强制终止 fork�?
                                 避免 CI 无限挂死（单例容器模式下 12 类正常耗时�?15~25 分钟�?-->
                            <forkedProcessTimeoutInSeconds>2700</forkedProcessTimeoutInSeconds>
                            <systemPropertyVariables>
                                <spring.profiles.active>integration-test</spring.profiles.active>
                            </systemPropertyVariables>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- 变异测试（测试成熟度阶段�?2.1）：mvn test-compile org.pitest:pitest-maven:mutationCoverage -pl <module> -Pmutation
             报告：target/pit-reports/。pitest 自带增量复用（timestampedReports=false），
             变异仅针对模块自身类（targetClasses 默认=当前模块包），避免跨模块误伤 -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>1.15.8</version>
                        <dependencies>
                            <!-- JUnit 5 支持（项目测试基�?JUnit Jupiter�?-->
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.3</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <!-- 默认变异当前模块的全部主代码；可�?-DtargetClasses/-DtargetTests 收窄 -->
                            <timestampedReports>false</timestampedReports>
                            <outputFormats>
                                <outputFormat>HTML</outputFormat>
                                <outputFormat>XML</outputFormat>
                            </outputFormats>
                            <!-- 变异算子默认集（条件边界/取反/数学/返回�?空返�?void方法调用�?-->
                            <mutators>
                                <mutator>DEFAULTS</mutator>
                            </mutators>
                            <!-- 单个变异超时与整体限流，避免 CI/本地挂死 -->
                            <timeoutConstant>8000</timeoutConstant>
                            <threads>4</threads>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- 依赖漏洞扫描（测试成熟度阶段�?2.3.2）：mvn verify -Psecurity -DnvdApiKey=xxx（可选）
             报告：各模块 target/dependency-check-report.html�?
             注意：NVD API �?key 时严格限速，首次运行需较长时间下载漏洞库；
             建议通过 -DnvdApiKey 传入（勿提交到仓库） -->
        <profile>
            <id>security</id>
            <properties>
                <!-- 默认空：未传 -DnvdApiKey 时无 key 限速运行（不阻断） -->
                <nvdApiKey></nvdApiKey>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>10.0.4</version>
                        <configuration>
                            <!-- CVSS �?7（高危）才失败，中低危登记台账人工处�?-->
                            <failBuildOnCVSS>7</failBuildOnCVSS>
                            <formats>
                                <format>HTML</format>
                                <format>JSON</format>
                            </formats>
                            <skipProvidedScope>true</skipProvidedScope>
                            <skipSystemScope>true</skipSystemScope>
                            <!-- NVD API key（可选，�?key 会限速但不阻断） -->
                            <nvdApiKey>${nvdApiKey}</nvdApiKey>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
