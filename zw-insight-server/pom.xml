    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.6</version>
        <relativePath/>
    </parent>

    <groupId>com.zwinsight</groupId>
    <artifactId>zw-insight-server</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ZW Insight Server</name>
    <description>中维智营 - 工程项目管理平台后端服务</description>

    <modules>
        <module>zw-common</module>
        <module>zw-security</module>
        <module>zw-system</module>
        <module>zw-workflow</module>
        <module>zw-message</module>
        <module>zw-file</module>
        <module>zw-project</module>
        <module>zw-tender</module>
        <module>zw-contract</module>
        <module>zw-budget</module>
        <module>zw-purchase</module>
        <module>zw-labor</module>
        <module>zw-material</module>
