<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://www.zwinsight.com/contract"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/MODEL/BPMN20.xsd">

    <process id="construction_contract_approval" name="施工合同审批" isExecutable="true">

        <!-- 开始事件 -->
        <startEvent id="startEvent" name="提交合同"/>

        <!-- 顺序流：开始 → 项目负责人审批 -->
        <sequenceFlow id="flow1" sourceRef="startEvent" targetRef="managerApproval"/>

        <!-- 项目负责人审批 -->
        <userTask id="managerApproval" name="项目负责人审批"
                  flowable:assignee="${initiator}">
            <documentation>施工合同 - 项目负责人确认合同条款与金额</documentation>
        </userTask>

        <!-- 顺序流：项目负责人审批 → 财务审核 -->
        <sequenceFlow id="flow2" sourceRef="managerApproval" targetRef="financeApproval"/>

        <!-- 财务审核 -->
        <userTask id="financeApproval" name="财务审核"
                  flowable:assignee="${initiator}">
            <documentation>施工合同 - 财务确认税率与收付款条款</documentation>
        </userTask>

        <!-- 顺序流：财务审核 → 结束 -->
        <sequenceFlow id="flow3" sourceRef="financeApproval" targetRef="endEvent"/>

        <!-- 结束事件（PROCESS_COMPLETED 事件触发 CONSTRUCTION_CONTRACT 审批通过回调，合同置 EFFECTIVE） -->
        <endEvent id="endEvent" name="审批完成"/>

    </process>

</definitions>
