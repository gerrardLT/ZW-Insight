<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://www.zwinsight.com/contract"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/MODEL/BPMN20.xsd">

    <process id="final_settlement_approval" name="竣工结算审批" isExecutable="true">

        <startEvent id="startEvent" name="提交竣工结算"/>

        <sequenceFlow id="flow1" sourceRef="startEvent" targetRef="managerApproval"/>

        <userTask id="managerApproval" name="项目负责人审批"
                  flowable:candidateGroups="PROJECT_MANAGER">
            <documentation>竣工结算 - 项目负责人审批工程结算金额与决算确认</documentation>
        </userTask>

        <sequenceFlow id="flow2" sourceRef="managerApproval" targetRef="endEvent"/>

        <endEvent id="endEvent" name="审批完成"/>

    </process>

</definitions>
