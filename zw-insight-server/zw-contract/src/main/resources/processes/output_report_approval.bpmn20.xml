<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://www.zwinsight.com/contract"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/MODEL/BPMN20.xsd">

    <process id="output_report_approval" name="产值报告审批" isExecutable="true">

        <!-- 开始事件 -->
        <startEvent id="startEvent" name="提交产值报告"/>

        <!-- 顺序流：开始 → 项目负责人审批 -->
        <sequenceFlow id="flow1" sourceRef="startEvent" targetRef="managerApproval"/>

        <!-- 项目负责人审批 -->
        <userTask id="managerApproval" name="项目负责人审批"
                  flowable:assignee="${initiator}">
            <documentation>产值报告 - 项目负责人确认当期完成产值</documentation>
        </userTask>

        <!-- 顺序流：项目负责人审批 → 财务审核 -->
        <sequenceFlow id="flow2" sourceRef="managerApproval" targetRef="financeApproval"/>

        <!-- 财务审核 -->
        <userTask id="financeApproval" name="财务审核"
                  flowable:assignee="${initiator}">
            <documentation>产值报告 - 财务复核产值与合同额度</documentation>
        </userTask>

        <!-- 顺序流：财务审核 → 结束 -->
        <sequenceFlow id="flow3" sourceRef="financeApproval" targetRef="endEvent"/>

        <!-- 结束事件（PROCESS_COMPLETED 事件触发 OUTPUT_REPORT 审批通过回调，回写合同/项目累计产值） -->
        <endEvent id="endEvent" name="审批完成"/>

    </process>

</definitions>
