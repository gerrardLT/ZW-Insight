<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://www.zwinsight.com/hr"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/MODEL/BPMN20.xsd">

    <process id="seal_apply_approval" name="用印申请审批" isExecutable="true">

        <!-- 开始事件 -->
        <startEvent id="startEvent" name="提交用印申请"/>

        <!-- 顺序流：开始 → 行政审批 -->
        <sequenceFlow id="flow1" sourceRef="startEvent" targetRef="adminApproval"/>

        <!-- 行政审批 -->
        <userTask id="adminApproval" name="行政审批"
                  flowable:assignee="${initiator}">
            <documentation>用印申请 - 行政确认印章类型与用印事由</documentation>
        </userTask>

        <!-- 顺序流：行政审批 → 结束 -->
        <sequenceFlow id="flow2" sourceRef="adminApproval" targetRef="endEvent"/>

        <!-- 结束事件（审批通过后由 SealApplyService.onApproved 置 APPROVED） -->
        <endEvent id="endEvent" name="审批完成"/>

    </process>

</definitions>
