<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zwinsight</groupId>
        <artifactId>zw-insight-server</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>zw-insight-project</artifactId>
    <name>ZW Insight Project</name>
    <description>项目报备模块 - 项目信息管理、项目成员</description>

    <properties>
        <!-- JaCoCo 行覆盖率分档门槛（事项 1-B，2026-08-24）：取值 = tests/coverage-baseline.json 当前基线千分比，补测后上调并同步基线。
             2026-09-07：补 ProjectWbsNodeService 单测（55 例）后 clean verify 实测 583/782 = 0.745524（CI 千分比截断 745‰），
             由 0.572 上调至 0.744，留约 1.5‰ 缓冲。
             回归参照：cost-control-backbone(5735439) 引入的 ProjectWbsNodeService 曾零测试覆盖，
             移出本测试文件后 clean verify 实测 343/782 = 0.438，触发
             「Rule violated ... ratio is 0.438, but expected minimum is 0.572」BUILD FAILURE。 -->
        <jacoco.min.coverage>0.744</jacoco.min.coverage>
    </properties>

    <dependencies>
        <!-- 内部模块 -->
        <dependency>
            <groupId>com.zwinsight</groupId>
            <artifactId>zw-insight-common</artifactId>
        </dependency>
        <!-- 复用 zw-common 的测试基类（IntegrationTestBase 等） -->
        <dependency>
            <groupId>com.zwinsight</groupId>
            <artifactId>zw-insight-common</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.zwinsight</groupId>
            <artifactId>zw-insight-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zwinsight</groupId>
            <artifactId>zw-insight-file</artifactId>
        </dependency>
        <!-- 审批流（项目结项审批） -->
        <dependency>
            <groupId>com.zwinsight</groupId>
            <artifactId>zw-insight-workflow</artifactId>
        </dependency>

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
    </dependencies>

</project>
