<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://www.zwinsight.com/finance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/MODEL/BPMN20.xsd">

    <process id="payment_apply_approval" name="付款申请审批" isExecutable="true">

        <!-- 开始事件 -->
        <startEvent id="startEvent" name="提交付款申请"/>

        <!-- 顺序流：开始 → 项目负责人审批 -->
        <sequenceFlow id="flow1" sourceRef="startEvent" targetRef="managerApproval"/>

        <!-- 项目负责人审批 -->
        <userTask id="managerApproval" name="项目负责人审批"
                  flowable:assignee="${initiator}">
            <documentation>付款申请 - 项目负责人确认付款条件与进度</documentation>
        </userTask>

        <!-- 顺序流：项目负责人审批 → 财务审核 -->
        <sequenceFlow id="flow2" sourceRef="managerApproval" targetRef="financeApproval"/>

        <!-- 财务审核 -->
        <userTask id="financeApproval" name="财务审核"
                  flowable:assignee="${initiator}">
            <documentation>付款申请 - 财务复核付款金额与未付余额</documentation>
        </userTask>

        <!-- 顺序流：财务审核 → 金额档位网关（54_V2026_52 分级审批） -->
        <sequenceFlow id="flow3" sourceRef="financeApproval" targetRef="gwTier3"/>

        <!-- 档位网关一：approvalTier>=3（>50万红线）追加财务负责人审批；否则直接结束。
             approvalTier 恒有值（未启用分级时=0），走 default 流，向后兼容既有线性链。 -->
        <exclusiveGateway id="gwTier3" name="是否需财务负责人" default="flow3_toEnd"/>
        <sequenceFlow id="flow3_toEnd" sourceRef="gwTier3" targetRef="endEvent"/>
        <sequenceFlow id="flow3_toCfo" sourceRef="gwTier3" targetRef="cfoApproval">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${approvalTier >= 3}]]></conditionExpression>
        </sequenceFlow>

        <!-- 财务负责人审批（tier=3，50万~500万） -->
        <userTask id="cfoApproval" name="财务负责人审批"
                  flowable:assignee="${initiator}">
            <documentation>付款申请 - 金额≥50万，财务负责人复核资金计划与头寸</documentation>
        </userTask>

        <!-- 顺序流：财务负责人 → 档位网关二 -->
        <sequenceFlow id="flow4" sourceRef="cfoApproval" targetRef="gwTier4"/>

        <!-- 档位网关二：approvalTier>=4（>500万）追加老板终审；否则结束 -->
        <exclusiveGateway id="gwTier4" name="是否需老板" default="flow4_toEnd"/>
        <sequenceFlow id="flow4_toEnd" sourceRef="gwTier4" targetRef="endEvent"/>
        <sequenceFlow id="flow4_toBoss" sourceRef="gwTier4" targetRef="bossApproval">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${approvalTier >= 4}]]></conditionExpression>
        </sequenceFlow>

        <!-- 老板审批（tier=4，500万以上） -->
        <userTask id="bossApproval" name="老板审批"
                  flowable:assignee="${initiator}">
            <documentation>付款申请 - 金额≥500万，老板终审</documentation>
        </userTask>

        <!-- 顺序流：老板审批 → 结束 -->
        <sequenceFlow id="flow5" sourceRef="bossApproval" targetRef="endEvent"/>

        <!-- 结束事件（PROCESS_COMPLETED 事件触发 PAYMENT_APPLY 审批通过回调） -->
        <endEvent id="endEvent" name="审批完成"/>

    </process>

</definitions>
