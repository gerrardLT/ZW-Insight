<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://www.zwinsight.com/budget"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/MODEL/BPMN20.xsd">

    <process id="budget_change_approval" name="预算变更审批" isExecutable="true">

        <!-- 开始事件 -->
        <startEvent id="startEvent" name="提交预算变更"/>

        <!-- 顺序流：开始 → 项目负责人审批 -->
        <sequenceFlow id="flow1" sourceRef="startEvent" targetRef="managerApproval"/>

        <!-- 项目负责人审批 -->
        <userTask id="managerApproval" name="项目负责人审批"
                  flowable:assignee="${initiator}">
            <documentation>预算变更 - 项目负责人确认调整金额与理由</documentation>
        </userTask>

        <!-- 顺序流：项目负责人审批 → 财务审核 -->
        <sequenceFlow id="flow2" sourceRef="managerApproval" targetRef="financeApproval"/>

        <!-- 财务审核 -->
        <userTask id="financeApproval" name="财务审核"
                  flowable:assignee="${initiator}">
            <documentation>预算变更 - 财务复核调整额度与预算余额</documentation>
        </userTask>

        <!-- 顺序流：财务审核 → 结束 -->
        <sequenceFlow id="flow3" sourceRef="financeApproval" targetRef="endEvent"/>

        <!-- 结束事件（PROCESS_COMPLETED 事件触发 BUDGET_CHANGE 审批通过回调，回写预算明细/总额） -->
        <endEvent id="endEvent" name="审批完成"/>

    </process>

</definitions>
