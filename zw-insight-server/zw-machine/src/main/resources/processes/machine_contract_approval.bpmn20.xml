<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://www.zwinsight.com/machine">
    <process id="machine_contract_approval" name="机械合同审批" isExecutable="true">
        <startEvent id="startEvent"/>
        <sequenceFlow id="flow1" sourceRef="startEvent" targetRef="managerApproval"/>
        <userTask id="managerApproval" name="项目负责人审批" flowable:candidateGroups="PROJECT_MANAGER"/>
        <sequenceFlow id="flow2" sourceRef="managerApproval" targetRef="financeApproval"/>
        <userTask id="financeApproval" name="财务审核" flowable:candidateGroups="FINANCE_STAFF"/>
        <sequenceFlow id="flow3" sourceRef="financeApproval" targetRef="endEvent"/>
        <endEvent id="endEvent"/>
    </process>
</definitions>
