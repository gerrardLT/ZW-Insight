<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://www.zwinsight.com/labor"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/MODEL/BPMN20.xsd">

    <process id="labor_payroll_approval" name="劳务工资单审批" isExecutable="true">
        <startEvent id="startEvent" name="提交劳务工资单"/>
        <sequenceFlow id="flow1" sourceRef="startEvent" targetRef="pmApproval"/>
        <userTask id="pmApproval" name="项目经理审核" flowable:candidateGroups="PROJECT_MANAGER">
            <documentation>劳务工资单 - 核实工人出勤工日与计件核定金额</documentation>
        </userTask>
        <sequenceFlow id="flow2" sourceRef="pmApproval" targetRef="financeApproval"/>
        <userTask id="financeApproval" name="财务复核" flowable:candidateGroups="FINANCE_STAFF">
            <documentation>劳务工资单 - 复核工资款项与代发专户额度</documentation>
        </userTask>
        <sequenceFlow id="flow3" sourceRef="financeApproval" targetRef="endEvent"/>
        <endEvent id="endEvent" name="审批完成"/>
    </process>

</definitions>
