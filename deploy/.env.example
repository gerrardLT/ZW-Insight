# ==============================================================================
# ZW-Insight 部署环境变量模板 (.env.example)
# 使用说明：在新服务器上复制此文件为 .env，并根据服务器实际需求调整配置
# 命令：cp .env.example .env
# ==============================================================================

# 项目与容器命名前缀（如果同一台机器运行多套环境，可设置不同名称，如 zwi-staging、zwi-prod）
COMPOSE_PROJECT_NAME=zwinsight-debug
CONTAINER_PREFIX=zwi

# 运行 Profile (dev / prod)
SPRING_PROFILES_ACTIVE=dev

# ──────────────────────────────────────────────────────────────────────────────
# 镜像配置 (CI 自动通过 GitHub Packages 推送并注入 ghcr.io/<owner>/zwinsight-*；本地手动构建留默认即可)
# ──────────────────────────────────────────────────────────────────────────────
BACKEND_IMAGE=zwinsight-backend
FRONTEND_IMAGE=zwinsight-frontend
IMAGE_TAG=debug

# ──────────────────────────────────────────────────────────────────────────────
# 宿主机映射端口（支持多实例在同一台机器共存，如 18080/18081 或 28080/28081）
# ──────────────────────────────────────────────────────────────────────────────
BACKEND_PORT=18080
FRONTEND_PORT=18081

# ──────────────────────────────────────────────────────────────────────────────
# 基础设施凭证（各生产/测试服务器请设置不同强密码）
# ──────────────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=zwinsight123
MYSQL_DATABASE=zw_insight
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=zwinsight123

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# JWT 鉴权密钥（生产环境建议生成高强度 32+ 字符随机串）
JWT_SECRET=ZwInsight2024SecretKeyForJwtTokenGeneration

# ──────────────────────────────────────────────────────────────────────────────
# 容器资源上限（根据服务器规格灵活调整，防止 OOM 拖垮系统）
# ──────────────────────────────────────────────────────────────────────────────
MYSQL_MEM_LIMIT=900m
REDIS_MEM_LIMIT=256m
MINIO_MEM_LIMIT=384m
RABBITMQ_MEM_LIMIT=512m
BACKEND_MEM_LIMIT=1200m
FRONTEND_MEM_LIMIT=128m

# ──────────────────────────────────────────────────────────────────────────────
# 短信服务：129/zwny 使用 aliyun；43/徽颖使用 tencent。只启用所选 Provider。
# ──────────────────────────────────────────────────────────────────────────────
SMS_PROVIDER=aliyun
SMS_ENABLED=false

ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
